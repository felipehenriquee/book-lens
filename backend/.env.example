# Banco de dados (MySQL/MariaDB, driver assíncrono asyncmy)
# Alternativa: mysql+aiomysql://...
DATABASE_URL=mysql+asyncmy://booklens:booklens@db:3306/booklens
# Rodando a API fora do Docker (npm run dev na raiz):
# DATABASE_URL=mysql+asyncmy://booklens:booklens@localhost:3307/booklens
DATABASE_POOL_PRE_PING=true
DATABASE_POOL_RECYCLE=3600

# Segurança / JWT
JWT_SECRET_KEY=change-this-to-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Gemini API (google-genai)
GEMINI_API_KEY=your-gemini-api-key

# Google Books API (opcional)
GOOGLE_BOOKS_API_KEY=

# CORS - domínio do frontend Angular
CORS_ORIGINS=["http://localhost:4200"]

# Rate limiting
OCR_RATE_LIMIT=10/minute

# Se true, /ocr/scan não chama a Gemini de verdade (evita gastar cota em
# desenvolvimento) e retorna sempre "O Chamado do Cuco" como livro detectado.
OCR_MOCK_ENABLED=false

# Usuário criado automaticamente ao subir a API (apenas desenvolvimento).
# Deixe vazio em produção.
DEV_USER_EMAIL=dev@booklens.com
DEV_USER_PASSWORD=booklens123

# Infraestrutura da fila (npm run infra sobe os dois em Docker)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=amqp://booklens:booklens@localhost:5672//

# Fila de scans (opcional: estes são os valores padrão)
# SCAN_WORKER_CONCURRENCY=4
# SCAN_MAX_CONCURRENT_PER_USER=2
# GEMINI_MAX_REQUESTS_PER_MINUTE=10
# SCAN_STORAGE_DIR=storage/scans
# SCAN_MAX_FILES_PER_UPLOAD=10
# SCAN_UPLOAD_RATE_LIMIT=10/minute
# SCAN_JOB_RETENTION_DAYS=7
